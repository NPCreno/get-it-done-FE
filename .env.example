NEXT_PUBLIC_API_URL=http://localhost:8000/api
# This value is compiled into browser code. Do not use Docker service names here.

# A unique, server-only signing secret. Do not commit a real value.
JWT_SECRET=

# Server-only. Must equal INTERNAL_API_SECRET on the backend. Attests the forwarded client IP.
INTERNAL_API_SECRET=
# Set to "vercel" in Vercel project settings only; allows reading Vercel IP headers.
TRUSTED_PROXY=
